{
  "name": "mint",
  "version": "0.1.0-alpha.3",
  "description": "mint: an agent harness for self-study. Bring your own materials; the tutor plans, teaches and checks you, then steps back.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Keti Yohannes",
  "scripts": {
    "prepare-runtimes": "node scripts/build-diagram-runtime.mjs && node scripts/prepare-pyodide.mjs",
    "dev": "npm run prepare-runtimes && electron-vite dev",
    "build": "npm run prepare-runtimes && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm test && npm run test:e2e",
    "dist": "npm run build && electron-builder --publish never",
    "icon": "python3 -I scripts/make-icon.py build",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@mozilla/readability": "0.6.0",
    "jsdom": "30.1.3",
    "mammoth": "1.13.0",
    "unpdf": "2.1.0",
    "youtubei.js": "18.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "1.64.1",
    "@tiptap/extension-highlight": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-subscript": "^3.32.2",
    "@tiptap/extension-superscript": "^3.32.2",
    "@tiptap/extension-text-align": "^3.32.2",
    "@tiptap/extension-typography": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/p5": "1.7.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "codemirror": "6.0.2",
    "dompurify": "3.4.17",
    "electron": "45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "marked": "18.1.3",
    "p5": "1.11.13",
    "pdfjs-dist": "5.7.284",
    "pyodide": "314.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "protobufjs": false
  },
  "homepage": "https://github.com/ketiyohannes/mint",
  "repository": {
    "type": "git",
    "url": "https://github.com/ketiyohannes/mint.git"
  },
  "license": "MIT"
}
