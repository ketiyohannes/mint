{
  "name": "mint",
  "version": "0.1.0",
  "description": "mint: an agent harness for self-study. Source-grounded, adaptive, built to make you need it less.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "author": "Keti Yohannes",
  "scripts": {
    "prepare-runtimes": "node scripts/build-diagram-runtime.mjs && node scripts/prepare-ort.mjs",
    "dev": "npm run prepare-runtimes && electron-vite dev",
    "build": "npm run prepare-runtimes && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "1.3.0",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "dompurify": "3.4.17",
    "jsdom": "30.1.3",
    "katex": "0.19.1",
    "mammoth": "1.13.0",
    "marked": "18.1.3",
    "p5": "1.11.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "unpdf": "2.1.0",
    "youtubei.js": "18.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/p5": "1.7.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-vite": "6.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
